{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "anytars",
  "compatibility_date": "2026-11-01",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application"
  },
  "routes": [
    { "pattern": "anytars.davebuilds.net", "custom_domain": true }
  ],
  "workers_dev": false
}
