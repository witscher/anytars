{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "anytars",
  "main": "apps/maker/worker/worker.js",
  "compatibility_date": "2026-11-01",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    // HTML pages go through the Worker, which adds the operator's legal links (see withLegalLinks in worker.js).
    "run_worker_first": ["/api/*", "/", "/index.html", "/lab", "/lab/*"]
  },
  // LEGAL_IMPRINT_URL and LEGAL_PRIVACY_URL are set per deployment in the Cloudflare dashboard, never here;
  // keep_vars stops a deploy from removing them.
  "keep_vars": true,
  // Workers AI: Clef flash (text edits) and Clef omni (photo analysis)
  "ai": { "binding": "AI" },
  // Per-IP limit on the AI endpoints
  "ratelimits": [
    { "name": "AI_LIMIT", "namespace_id": "7311", "simple": { "limit": 20, "period": 60 } }
  ],
  "observability": { "enabled": false },
  "routes": [
    { "pattern": "anytars.davebuilds.net", "custom_domain": true }
  ],
  "workers_dev": false
}
